# --- Variables de entorno para Vercel ---
# Copia como valores en el proyecto de Vercel (Settings -> Environment Variables).

# Clave de moderador: sirve para el login en /moderador Y para firmar el token.
# Ponla larga (una frase). Cambiarla invalida cualquier sesion de moderador abierta.
MOD_KEY=

# Token de ingesta: lo manda el navegador del participante al guardar su sesion.
# No es secreto (va en el bundle del cliente), solo evita posteos accidentales/bots.
# INGEST_TOKEN (servidor) y VITE_INGEST_TOKEN (cliente) deben tener EL MISMO valor.
INGEST_TOKEN=
VITE_INGEST_TOKEN=

# BLOB_READ_WRITE_TOKEN lo genera Vercel solo al agregar un store de Blob
# (Storage -> Create -> Blob). Para 'vercel dev' local: `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
